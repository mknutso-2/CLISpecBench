{
  "datatypes": {
    "Age": {
      "allows_empty": true,
      "grammar": "Age = [[ageBound D] ageDuration]",
      "section_id": "age"
    },
    "DateValue": {
      "allows_empty": true,
      "calendars": [
        "GREGORIAN",
        "JULIAN",
        "FRENCH_R",
        "HEBREW"
      ],
      "restrict_words": [
        "FROM",
        "TO",
        "BET",
        "AND",
        "BEF",
        "AFT",
        "ABT",
        "CAL",
        "EST"
      ],
      "section_id": "date"
    },
    "FilePath": {
      "gedzip_reserved_names": [
        "gedcom.ged",
        "MANIFEST.MF",
        "META-INF/"
      ],
      "local_forbidden_prefixes": [
        "/"
      ],
      "local_forbidden_segments": [
        ".."
      ],
      "section_id": "file-path",
      "supported_schemes": [
        "",
        "file",
        "ftp",
        "http",
        "https"
      ]
    },
    "Language": {
      "section_id": "language",
      "source": "BCP 47 language tag"
    },
    "Latitude": {
      "hemispheres": [
        "N",
        "S"
      ],
      "max_degrees": 90,
      "section_id": "latitude"
    },
    "Longitude": {
      "hemispheres": [
        "E",
        "W"
      ],
      "max_degrees": 180,
      "section_id": "longitude"
    },
    "MediaType": {
      "section_id": "media-type",
      "source": "RFC 2045 section 5.1 plus HTTP-style parameters"
    },
    "TagDef": {
      "grammar": "TagDef = extTag D URI-reference",
      "section_id": "tag-definition"
    },
    "Time": {
      "allows_24_hour": false,
      "allows_leap_second": false,
      "section_id": "time",
      "utc_suffix": "Z"
    },
    "URI": {
      "section_id": "uri",
      "source": "RFC 3986 URI-reference"
    }
  },
  "enumerations": {
    "ADOP": [
      "HUSB",
      "WIFE",
      "BOTH"
    ],
    "EVEN": [
      "CENS"
    ],
    "EVENATTR": [
      "CENS",
      "NCHI",
      "RESI",
      "FACT",
      "EVEN"
    ],
    "FAMC-STAT": [
      "CHALLENGED",
      "DISPROVEN",
      "PROVEN"
    ],
    "MEDI": [
      "AUDIO",
      "BOOK",
      "CARD",
      "ELECTRONIC",
      "FICHE",
      "FILM",
      "MAGAZINE",
      "MANUSCRIPT",
      "MAP",
      "NEWSPAPER",
      "PHOTO",
      "TOMBSTONE",
      "VIDEO",
      "OTHER"
    ],
    "NAME-TYPE": [
      "AKA",
      "BIRTH",
      "IMMIGRANT",
      "MAIDEN",
      "MARRIED",
      "PROFESSIONAL",
      "OTHER"
    ],
    "PEDI": [
      "ADOPTED",
      "BIRTH",
      "FOSTER",
      "SEALING",
      "OTHER"
    ],
    "QUAY": [
      "0",
      "1",
      "2",
      "3"
    ],
    "RESN": [
      "CONFIDENTIAL",
      "LOCKED",
      "PRIVACY"
    ],
    "ROLE": [
      "CHIL",
      "CLERGY",
      "FATH",
      "FRIEND",
      "GODP",
      "HUSB",
      "MOTH",
      "MULTIPLE",
      "NGHBR",
      "OFFICIATOR",
      "PARENT",
      "SPOU",
      "WIFE",
      "WITN",
      "OTHER"
    ],
    "SEX": [
      "M",
      "F",
      "X",
      "U"
    ],
    "ord-STAT": [
      "BIC",
      "CANCELED",
      "CHILD",
      "COMPLETED",
      "EXCLUDED",
      "DNS",
      "DNS_CAN",
      "INFANT",
      "PRE_1970",
      "STILLBORN",
      "SUBMITTED",
      "UNCLEARED"
    ]
  },
  "gedzip": {
    "dataset_entry": "gedcom.ged",
    "entry_names_are_utf8_case_sensitive": true,
    "file_extension": ".gdz",
    "format": "ZIP archive",
    "local_file_payloads_must_have_matching_entries": true,
    "section_id": "gedzip",
    "zip_entry_names_are_not_percent_escaped": true
  }
}
