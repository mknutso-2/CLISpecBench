@comment{Reference .bib corpus #2 for byte-exact BibTeX parity tests.}
@comment{Focuses on name-grammar edges, predefined-month macros, ligatures,
         long author lists (and others), concatenation patterns, and mixed
         Form 1/2/3 names in one database.}

@preamble{"\newcommand{\noop}[1]{}"}

@string{assoc = "Association for"}
@string{comp  = "Computing Machinery"}
@string{aymd  = assoc # " " # comp}

@string{rand = "Research and Development"}

% Form 1 (First von Last): tied tokens, brace-protected von.
@article{von1867,
  author  = "Hermann~von Helmholtz",
  title   = "Handbuch der {P}hysiologischen {O}ptik",
  journal = "Voss",
  year    = 1867,
  month   = jan
}

% Form 2 (von Last, First): pre-von upper-case run, name with tie.
@book{vanDerP,
  author    = "van der Pol, Balthasar~{van~Dijk}",
  title     = "On Relaxation-Oscillations",
  publisher = "Philosophical Magazine",
  year      = 1926
}

% Form 3 (von Last, Jr, First).
@book{mouse,
  author    = "Mouse, {Jr.}, Mickey",
  title     = "The Mickey Mouse Story",
  publisher = "Disney",
  year      = 1928
}

% Multiple authors separated by "and", one with "and" inside braces.
@inproceedings{andteam,
  author    = "Smith, John and {Rock and Roll Hall of Fame} and Doe, Jane",
  title     = "Music Computing at Scale",
  booktitle = "Proc. " # aymd # " Music Workshop",
  year      = 2019,
  month     = may
}

% "and others" → et al. rendering in styles.
@article{biganglia,
  author  = "Bianchini, A. and Martinez, R. and Okonkwo, O. and others",
  title   = "Deep Learning in Radiology",
  journal = "J. of Biomedical Research",
  year    = 2022,
  month   = aug,
  volume  = 42,
  number  = 7,
  pages   = "1205--1219"
}

% Ligatures and accent macros in title (depth-1 only per spec §8.2).
@article{paper_accents,
  author  = "Gödel, Kurt",
  title   = "{\"U}ber formal unentscheidbare {S}{\"a}tze der {Principia {M}athematica}",
  journal = "Monatshefte f{\"u}r Mathematik",
  year    = 1931
}

% Concatenation: year = string # "-" # integer.
@article{concatexample,
  author = "Turing, A. M.",
  title  = "On Computable Numbers, with an Application to the {E}ntscheidungsproblem",
  journal = "Proc. London Math. Soc.",
  year   = "1936" # "--" # "37",
  volume = 2
}

% Crossref inheritance with case-insensitive lookup.
@proceedings{ProcICML2018,
  title     = "Proceedings of the 35th {International Conference on Machine Learning}",
  year      = 2018,
  publisher = aymd,
  month     = jul
}

@inproceedings{bengio-icml-2018,
  author    = "Yoshua Bengio",
  title     = "Deep Learning: Where Next?",
  crossref  = "procicml2018"
}

% Predefined month macros: january ... december.
@misc{newyear,
  author = "Doe, J.",
  title  = "A New Year Retrospective",
  year   = 2020,
  month  = dec
}

% Unicode-ish name via brace-protected diacritics (ASCII safe).
@article{erdos,
  author  = "P{\\'a}l Erd{\"o}s",
  title   = "On the Distribution of Primes",
  journal = "Acta Mathematica",
  year    = 1949
}

% Trailing comma + whitespace.
@article{trailcomma,
  author = "Nobody",
  title  = "X",
  year   = 2000,
}

